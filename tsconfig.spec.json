/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    // `node` entra por causa do `documentacao.spec.ts`, que lê os arquivos de docs/ do
    // disco. Sem ele o TypeScript não tipa o `node:fs` e o build do teste falha em
    // TS7006, com a mensagem apontando para o parâmetro do callback, não para a causa.
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/test-providers.ts"]
}
